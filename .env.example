# ============================================================================
# 任务12 · 环境变量模板
#
# 使用方式：复制成 .env 再填真实值
#     cp .env.example .env        （Windows: copy .env.example .env）
#
# 为什么单独放模板：
#     根目录的 .env 已被 .gitignore 与 .dockerignore 双重排除 —— 它既不会进仓库，
#     也不会进镜像。镜像里没有任何密钥，密钥只在容器启动时由 compose 从宿主机注入。
# ============================================================================

# DeepSeek 开放平台密钥（必填，否则 /api/chat 会返回缺少密钥的错误）
DEEPSEEK_API_KEY=sk-在这里填你自己的key

# 接口地址（一般不用改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 使用的模型（需与开放平台里可用的模型名一致）
DEEPSEEK_MODEL=deepseek-v4-pro
